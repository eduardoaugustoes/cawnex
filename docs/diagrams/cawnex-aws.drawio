        <mxCell id="dev-pubA" value="&lt;b&gt;Public subnet&lt;/b&gt; /24&lt;br&gt;&lt;font color=#666&gt;routes 0.0.0.0/0 &#x2192; IGW&lt;br&gt;ALB target&lt;br&gt;&lt;b&gt;Fargate tasks live here&lt;/b&gt;&lt;br&gt;(public IPs assigned)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=8;" vertex="1" parent="1">
