        <mxCell id="data-s3-art" value="&lt;b&gt;cawnex-artifacts-${stage}-${account}&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Versioned in prod &#183; lifecycle expires tmp/ after 7d&lt;br&gt;Consumers: API + Worker for crow outcome archives (large planner/reviewer payloads that don&#x27;t fit in DDB item size)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=11;" vertex="1" parent="1">
