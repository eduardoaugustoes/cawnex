        <mxCell id="svc-worker" value="&lt;b&gt;Worker task&lt;/b&gt;&lt;br&gt;cawnex-worker-${stage} &#183; 1 vCPU / 2GB&lt;br&gt;image: apps/worker/Dockerfile (asset)&lt;br&gt;desiredCount: &lt;b&gt;0&lt;/b&gt; (scaled to 1 by API/Monarch/scaler)&lt;br&gt;EFS mount /mnt/repos &#183; Spot (non-prod), on-demand (prod)&lt;br&gt;env: ANTHROPIC_MODEL=claude-haiku-4-5-20251001&lt;br&gt;env: MEMORY_INJECTION_ENABLED=true&lt;br&gt;secrets: GITHUB_TOKEN, ANTHROPIC_AUTH_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
