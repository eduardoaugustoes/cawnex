        <mxCell id="data-ddb-indexes" value="&lt;b&gt;Indexes&lt;/b&gt; &#183; GSI1 (GSI1PK/GSI1SK, ALL) &#x2014; reverse lookups (e.g. user &#x2192; projects) &#183; GSI2 (GSI2PK/GSI2SK, ALL) &#x2014; cross-tenant ops queries&lt;br&gt;&lt;b&gt;Streams&lt;/b&gt; &#183; NEW_AND_OLD_IMAGES &#x2014; consumed by Murder (no filter), Monarch (SK begins MONARCH#), Council (SK begins COUNCIL#)&lt;br&gt;&lt;b&gt;PITR&lt;/b&gt; on &#183; &lt;b&gt;TTL&lt;/b&gt; attribute = &lt;code&gt;ttl&lt;/code&gt; &#183; &lt;b&gt;Billing&lt;/b&gt; PAY_PER_REQUEST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;align=left;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="900" height="80" as="geometry" />
        </mxCell>

        <mxCell id="data-ddb-events-title" value="&lt;b&gt;DynamoDB&lt;/b&gt; cawnex-events-${stage} &#183; events table (TTL 24h)" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;fontColor=#0a4d2b;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
