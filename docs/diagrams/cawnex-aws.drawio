        <mxCell id="data-kms-detail" value="&lt;b&gt;alias/cawnex-vault-${stage}&lt;/b&gt; &#183; rotation enabled&lt;br&gt;&lt;font color=#666&gt;Used by API (encrypt) and Worker (decrypt) for the vault &#x2014; encrypted blob stored in DDB for user-supplied secrets (BYOK pattern, not actively used in current MVI flow)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=11;" vertex="1" parent="1">
