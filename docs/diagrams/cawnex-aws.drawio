        <mxCell id="dev-efs" value="&lt;b&gt;EFS&lt;/b&gt; cawnex-repos-${stage}&lt;br&gt;&lt;font color=#666&gt;mount targets in both public subnets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="590" width="460" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dev-warn" value="&lt;b&gt;&#x26a0; Implications of no-private-subnet posture&lt;/b&gt;&lt;br&gt;&lt;font color=#8b1a00&gt;&#x2022; Fargate tasks get &lt;b&gt;public IPs&lt;/b&gt; for egress to Anthropic/GitHub/DDB/SQS&lt;br&gt;&#x2022; SG ingress is the only network boundary &#x2014; no NAT allowlist, no private subnet hop&lt;br&gt;&#x2022; Cheaper (no NAT bill), faster cold starts&lt;br&gt;&#x2022; Acceptable for dev/staging; prod uses private + NAT for the same workload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="680" width="700" height="120" as="geometry" />
        </mxCell>

