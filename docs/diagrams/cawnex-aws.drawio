        </mxCell>

        <mxCell id="svc-stream" value="&lt;b&gt;Stream task&lt;/b&gt;&lt;br&gt;cawnex-stream-${stage} &#183; 0.25 vCPU / 512MB&lt;br&gt;image: apps/stream/Dockerfile (asset)&lt;br&gt;desiredCount: 1 &#183; port 8080 &#183; health /_health&lt;br&gt;ALB-fronted (HTTP/80) &#183; Spot/on-demand split&lt;br&gt;secrets: PIPE_SECRET" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
