        </mxCell>
        <mxCell id="data-events-detail" value="&lt;b&gt;PK&lt;/b&gt; project_id &#183; &lt;b&gt;SK&lt;/b&gt; E#{ts}#{uuid}&lt;br&gt;&lt;b&gt;Fields&lt;/b&gt; event_type (wave_status / mvi_status / pr_event), payload (JSON), expires_at (epoch +24h)&lt;br&gt;&lt;b&gt;Stream&lt;/b&gt; NEW_IMAGE only &#x2192; consumed by &lt;b&gt;only&lt;/b&gt; the EventBridge Pipe (Tab 4)&lt;br&gt;&lt;b&gt;GSI1&lt;/b&gt; (ALL) for cross-project event queries (e.g. all events for a user&#x27;s tenants)&lt;br&gt;&lt;b&gt;Writers&lt;/b&gt; API + Worker on wave/MVI state changes &#183; &lt;b&gt;Readers&lt;/b&gt; Stream Fargate via SQS, never queried directly by API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="900" height="140" as="geometry" />
        </mxCell>

        <mxCell id="data-efs-title" value="&lt;b&gt;EFS&lt;/b&gt; cawnex-repos-${stage} &#183; git worktree storage" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;fontColor=#0a4d2b;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="data-efs-detail" value="&lt;b&gt;Filesystem&lt;/b&gt; encrypted, GENERAL_PURPOSE, BURSTING, IA after 30d&lt;br&gt;&lt;b&gt;Access points&lt;/b&gt; one declared: DevTenantAP &#x2192; /T/dev-tenant (uid/gid 1000, perms 0750)&lt;br&gt;&lt;br&gt;&lt;b&gt;Layout under /mnt/repos in the Worker container:&lt;/b&gt;&lt;br&gt;/mnt/repos/T/{tenant_id}/{repo_name}/ &#x2014; bare clone, reused across crow runs&lt;br&gt;/mnt/repos/T/{tenant_id}/{repo_name}/.git/ &#x2014; the actual git data&lt;br&gt;&lt;br&gt;&lt;b&gt;Mount&lt;/b&gt; transit encryption + IAM-authenticated &#183; SG NFS/2049 ingress from WorkerSG only&lt;br&gt;&lt;b&gt;Limitation&lt;/b&gt; single &quot;dev-tenant&quot; access point &#x2014; multi-tenant production would create one access point per tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="850" width="900" height="180" as="geometry" />
        </mxCell>

        <mxCell id="data-secrets-title" value="&lt;b&gt;Secrets Manager&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;fontColor=#0a4d2b;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="780" height="32" as="geometry" />
        </mxCell>
        <mxCell id="data-sec-github" value="&lt;b&gt;cawnex/${stage}/github-token&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;GitHub PAT &#x2014; PR create, merge, comment, push&lt;br&gt;Consumers: Worker (ecs.Secret), API (&#x26a0; unsafeUnwrap to plain env)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="140" width="780" height="80" as="geometry" />
