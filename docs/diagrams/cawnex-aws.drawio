        </mxCell>

        <mxCell id="prod-e1" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;" edge="1" parent="1" source="prod-igw" target="prod-alb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="prod-e2" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;" edge="1" parent="1" source="prod-alb" target="prod-stream"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="prod-e3" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;" edge="1" parent="1" source="prod-worker" target="prod-efs"><mxGeometry relative="1" as="geometry" /></mxCell>
