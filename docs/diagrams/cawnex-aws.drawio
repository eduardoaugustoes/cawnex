          <mxGeometry x="1170" y="830" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dev-e1" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;" edge="1" parent="1" source="dev-igw" target="dev-alb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dev-e2" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;" edge="1" parent="1" source="dev-alb" target="dev-stream"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dev-e3" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;" edge="1" parent="1" source="dev-worker" target="dev-efs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dev-e4" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;" edge="1" parent="1" source="dev-worker" target="dev-igw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="510" /><mxPoint x="900" y="210" /></Array></mxGeometry></mxCell>

        <mxCell id="vpc-legend" value="&lt;b&gt;Note:&lt;/b&gt; Lambdas (API, Murder, Monarch, Council, Checker, Scaler) are &lt;b&gt;not VPC-attached&lt;/b&gt; &#x2014; they call DDB, SQS, Secrets Manager, ECS over public AWS endpoints from the Lambda fleet network. The VPC only contains the ALB + Fargate tasks + EFS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;align=left;verticalAlign=middle;fontSize=11;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="980" width="1580" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="wave" name="3. Wave Execution Flow">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-wf" value="Wave Execution Flow &#x2014; end-to-end on AWS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-wf" value="How an MVI travels from iOS submit to merged PR. Swimlanes per AWS service; numbered steps trace the loop." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="wf-lane-ios" value="iOS app" style="text;html=1;strokeColor=#000;fillColor=#f5f5f5;fontColor=#333;align=center;verticalAlign=top;fontSize=12;fontStyle=1;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="wf-lane-edge" value="CloudFront + API GW + Cognito" style="text;html=1;strokeColor=#000;fillColor=#ffe6cc;fontColor=#7e5b00;align=center;verticalAlign=top;fontSize=12;fontStyle=1;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="180" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="wf-lane-api" value="API Lambda" style="text;html=1;strokeColor=#000;fillColor=#dae8fc;fontColor=#1a3c6e;align=center;verticalAlign=top;fontSize=12;fontStyle=1;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="180" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="wf-lane-ddb" value="DynamoDB (main)" style="text;html=1;strokeColor=#000;fillColor=#d5e8d4;fontColor=#0a4d2b;align=center;verticalAlign=top;fontSize=12;fontStyle=1;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="180" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="wf-lane-murder" value="Murder Lambda" style="text;html=1;strokeColor=#000;fillColor=#dae8fc;fontColor=#1a3c6e;align=center;verticalAlign=top;fontSize=12;fontStyle=1;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="180" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="wf-lane-worker" value="Worker Fargate" style="text;html=1;strokeColor=#000;fillColor=#dae8fc;fontColor=#1a3c6e;align=center;verticalAlign=top;fontSize=12;fontStyle=1;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="100" width="180" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="wf-lane-ext" value="Anthropic + GitHub" style="text;html=1;strokeColor=#000;fillColor=#e1d5e7;fontColor=#4a1a7a;align=center;verticalAlign=top;fontSize=12;fontStyle=1;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="180" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="wf-lane-efs" value="EFS / Secrets" style="text;html=1;strokeColor=#000;fillColor=#d5e8d4;fontColor=#0a4d2b;align=center;verticalAlign=top;fontSize=12;fontStyle=1;rounded=0;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1440" y="100" width="180" height="1150" as="geometry" />
        </mxCell>

        <mxCell id="wf-s1" value="&lt;b&gt;1&lt;/b&gt; User taps&lt;br&gt;&quot;Start wave&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wf-s2" value="&lt;b&gt;2&lt;/b&gt; POST /waves&lt;br&gt;Bearer JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="140" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wf-s3" value="&lt;b&gt;3&lt;/b&gt; JWT validated by&lt;br&gt;HTTP API authorizer&lt;br&gt;&lt;font color=#666&gt;aud = iOS clientId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="220" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s4" value="&lt;b&gt;4&lt;/b&gt; Handler builds wave +&lt;br&gt;MVI snapshots from plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="220" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s5" value="&lt;b&gt;5&lt;/b&gt; PutItem&lt;br&gt;S#{wave} &#183; status=executing&lt;br&gt;S#{wave}#m{mvi} &#xd7; N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="220" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s6" value="&lt;b&gt;6&lt;/b&gt; 200 OK&lt;br&gt;wave_id returned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="320" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="wf-s7" value="&lt;b&gt;7&lt;/b&gt; DDB Stream emits&lt;br&gt;INSERT records&lt;br&gt;&#x2192; Murder event source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="400" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s8" value="&lt;b&gt;8&lt;/b&gt; Reactor dispatches&lt;br&gt;per MVI: level=murder&lt;br&gt;_handle_assign (planner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="400" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s9" value="&lt;b&gt;9&lt;/b&gt; UpdateItem&lt;br&gt;crow_kind=planner&lt;br&gt;claimed=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="500" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s10" value="&lt;b&gt;10&lt;/b&gt; ecs:UpdateService&lt;br&gt;desiredCount: 0 &#x2192; 1&lt;br&gt;&lt;font color=#666&gt;~30s task start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="500" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="wf-s11" value="&lt;b&gt;11&lt;/b&gt; Task starts&lt;br&gt;claims work via DDB&lt;br&gt;conditional UpdateItem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="600" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s12" value="&lt;b&gt;12&lt;/b&gt; Fetch secrets&lt;br&gt;GITHUB_TOKEN&lt;br&gt;ANTHROPIC_AUTH_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1450" y="600" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s13" value="&lt;b&gt;13&lt;/b&gt; git clone &#x2192; EFS&lt;br&gt;/mnt/repos/T/{tenant}/&lt;br&gt;{repo}&lt;br&gt;&lt;font color=#666&gt;cached across runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1450" y="700" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="wf-s14" value="&lt;b&gt;14&lt;/b&gt; Anthropic API&lt;br&gt;tool-use loop (planner)&lt;br&gt;&#x2192; emits N tasks via&lt;br&gt;submit_result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="700" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s15" value="&lt;b&gt;15&lt;/b&gt; UpdateItem&lt;br&gt;outcome=planner_result&lt;br&gt;tasks_total=N&lt;br&gt;claimed=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="800" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="wf-s16" value="&lt;b&gt;16&lt;/b&gt; Stream MODIFY&lt;br&gt;&#x2192; Murder reactor again&lt;br&gt;_handle_assign (implementer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="800" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s17" value="&lt;b&gt;17&lt;/b&gt; Worker runs implementer&lt;br&gt;tool-use loop&#x2192; writes files&lt;br&gt;to worktree, opens PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="900" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s18" value="&lt;b&gt;18&lt;/b&gt; GitHub REST&lt;br&gt;create branch, push,&lt;br&gt;open PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="900" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s19" value="&lt;b&gt;19&lt;/b&gt; UpdateItem&lt;br&gt;pr_number, head_sha&lt;br&gt;crow_kind=reviewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="1000" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="wf-s20" value="&lt;b&gt;20&lt;/b&gt; Stream &#x2192; Murder&lt;br&gt;Worker runs reviewer&lt;br&gt;&#x2192; verdict + blocking_issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1000" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s21" value="&lt;b&gt;21&lt;/b&gt; ready_to_ship&lt;br&gt;status=ready_to_ship&lt;br&gt;UpdateItem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="1100" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="wf-s22" value="&lt;b&gt;22&lt;/b&gt; iOS reads PR Review&lt;br&gt;screen via SSE&lt;br&gt;(see Tab 4)&lt;br&gt;Founder taps Merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="1100" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf-s23" value="&lt;b&gt;23&lt;/b&gt; POST .../prs/{n}/merge&lt;br&gt;API merges via GitHub REST&lt;br&gt;UpdateItem status=shipped&lt;br&gt;merge_sha set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="1180" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wf-s24" value="&lt;b&gt;24&lt;/b&gt; Stream &#x2192; Murder dispatch&lt;br&gt;react_to_mvi_terminal&lt;br&gt;all MVIs terminal &#x2192; Wave delivered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="1180" width="370" height="60" as="geometry" />
        </mxCell>

        <mxCell id="wfe-1" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;" edge="1" parent="1" source="wf-s1" target="wf-s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-2" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;" edge="1" parent="1" source="wf-s3" target="wf-s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-3" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;" edge="1" parent="1" source="wf-s4" target="wf-s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-4" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;" edge="1" parent="1" source="wf-s5" target="wf-s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-5" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=2;dashed=1;" edge="1" parent="1" source="wf-s5" target="wf-s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-6" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;" edge="1" parent="1" source="wf-s7" target="wf-s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-7" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;" edge="1" parent="1" source="wf-s8" target="wf-s9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-8" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;" edge="1" parent="1" source="wf-s9" target="wf-s10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-9" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;" edge="1" parent="1" source="wf-s10" target="wf-s11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-10" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;" edge="1" parent="1" source="wf-s11" target="wf-s12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-11" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;" edge="1" parent="1" source="wf-s11" target="wf-s13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-12" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;" edge="1" parent="1" source="wf-s11" target="wf-s14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-13" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;" edge="1" parent="1" source="wf-s14" target="wf-s15"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-14" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="wf-s15" target="wf-s16"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-15" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;" edge="1" parent="1" source="wf-s16" target="wf-s17"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-16" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;" edge="1" parent="1" source="wf-s17" target="wf-s18"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-17" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;" edge="1" parent="1" source="wf-s17" target="wf-s19"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-18" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="wf-s19" target="wf-s20"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-19" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;" edge="1" parent="1" source="wf-s20" target="wf-s21"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-20" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;dashed=1;" edge="1" parent="1" source="wf-s21" target="wf-s22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="1140" /><mxPoint x="130" y="1140" /></Array></mxGeometry></mxCell>
        <mxCell id="wfe-21" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333;" edge="1" parent="1" source="wf-s22" target="wf-s23"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="wfe-22" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="wf-s23" target="wf-s24"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="sse" name="4. SSE Event Flow">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-sse" value="SSE Event Flow &#x2014; the async fanout" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-sse" value="DDB writes &#x2192; iOS push-update via Server-Sent Events. ~1 second latency observed end-to-end." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="sse-step1" value="&lt;b&gt;1. Write side&lt;/b&gt;&lt;br&gt;&lt;br&gt;API or Worker writes to&lt;br&gt;&lt;b&gt;events table&lt;/b&gt;:&lt;br&gt;PK = project_id&lt;br&gt;SK = E#{ts}#{uuid}&lt;br&gt;event_type, payload&lt;br&gt;TTL: 24h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sse-step2" value="&lt;b&gt;2. DDB Stream&lt;/b&gt;&lt;br&gt;&lt;br&gt;cawnex-events-${stage}&lt;br&gt;stream config:&lt;br&gt;&lt;b&gt;NEW_IMAGE&lt;/b&gt;&lt;br&gt;shard iterators&lt;br&gt;polled by Pipe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sse-step3" value="&lt;b&gt;3. EventBridge Pipe&lt;/b&gt;&lt;br&gt;&lt;br&gt;cawnex-stream-events-&lt;br&gt;${stage}-v2&lt;br&gt;source: DDB Stream&lt;br&gt;target: SQS&lt;br&gt;batch 10, window 1s&lt;br&gt;TRIM_HORIZON&lt;br&gt;log TRACE all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sse-step4" value="&lt;b&gt;4. SQS&lt;/b&gt;&lt;br&gt;&lt;br&gt;cawnex-stream-events-${stage}&lt;br&gt;visibility 60s&lt;br&gt;retention 1d&lt;br&gt;DLQ after 5 failures&lt;br&gt;(14d retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sse-step5" value="&lt;b&gt;5. Stream Fargate&lt;/b&gt;&lt;br&gt;&lt;br&gt;cawnex-stream-${stage}&lt;br&gt;FastAPI on :8080&lt;br&gt;SqsPoller.start() in&lt;br&gt;lifespan&lt;br&gt;long-poll 20s &#183; batch 10&lt;br&gt;normalize_record()&lt;br&gt;&#x2192; publish_records()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="120" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sse-step6" value="&lt;b&gt;6. SubscriberRegistry&lt;/b&gt;&lt;br&gt;&lt;br&gt;in-process map:&lt;br&gt;(project_id, wave_id)&lt;br&gt;&#x2192; Subscriber[]&lt;br&gt;asyncio.Queue per sub&lt;br&gt;maxsize=64&lt;br&gt;QueueFull &#x2192; mark_dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1380" y="120" width="240" height="200" as="geometry" />
        </mxCell>

        <mxCell id="sse-step7" value="&lt;b&gt;7. ALB&lt;/b&gt;&lt;br&gt;&lt;br&gt;cawnex-stream-${stage}.&lt;br&gt;us-east-1.elb.amazonaws.com&lt;br&gt;HTTP :80 only&lt;br&gt;idle 120s&lt;br&gt;TG: IP-mode :8080&lt;br&gt;health /_health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="380" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sse-step8" value="&lt;b&gt;8. iOS SSE client&lt;/b&gt;&lt;br&gt;&lt;br&gt;EventStreamClient&lt;br&gt;URLSession.bytes(for:)&lt;br&gt;async for line in bytes:&lt;br&gt;&#x2002;decoder.consume(line)&lt;br&gt;&#x2192; SSEFrame &#x2192; WaveEvent&lt;br&gt;reconnect [1s,2s,5s,10s,10s]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1380" y="380" width="240" height="180" as="geometry" />
        </mxCell>

        <mxCell id="sse-route" value="&lt;b&gt;6a. Route handler&lt;/b&gt;&#10;GET /projects/{pid}/waves/{wid}/stream&#10;&#10;&#x2022; Validate JWT (Cognito JWKS, allowed_audiences = iOS+Web)&#10;&#x2022; Verify project belongs to tenant&#10;&#x2022; Register Subscriber in registry&#10;&#x2022; Yield SSE frames from queue&#10;&#x2022; Emit comment keepalive every 25s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="500" height="180" as="geometry" />
        </mxCell>

        <mxCell id="sse-pipe-detail" value="&lt;b&gt;Pipe auth (when target was HTTP)&lt;/b&gt;&#10;&#10;Originally Pipe &#x2192; HTTP /_pipe with X-Pipe-Secret header.&#10;&#10;Now: Pipe &#x2192; SQS (no HTTP target), so X-Pipe-Secret is &lt;b&gt;unused at runtime&lt;/b&gt;.&#10;The route still exists for direct testing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="480" height="180" as="geometry" />
        </mxCell>

        <mxCell id="sse-fail-note" value="&lt;b&gt;Failure modes&lt;/b&gt;&#10;&#10;&#x2022; iOS disconnects &#x2192; Subscriber removed from registry, dropped backlog discarded&#10;&#x2022; Slow consumer &#x2192; asyncio.Queue fills &#x2192; mark_dropped, optional last-event-id backfill (Phase 4, not yet built)&#10;&#x2022; Stream Fargate task restart &#x2192; subscribers re-connect via [1s,2s,5s,10s,10s] backoff &#x2192; new in-process registry&#10;&#x2022; SQS DLQ catches messages that fail 5 deliveries; alert-worthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="1560" height="140" as="geometry" />
        </mxCell>

        <mxCell id="sse-latency" value="&lt;b&gt;Latency budget (observed ~1s end-to-end)&lt;/b&gt; &#183; DDB write &lt;b&gt;~10ms&lt;/b&gt; &#x2192; Stream visible &lt;b&gt;~200ms&lt;/b&gt; &#x2192; Pipe batch flush &lt;b&gt;&#x2264;1000ms&lt;/b&gt; (window) &#x2192; SQS visible &lt;b&gt;~50ms&lt;/b&gt; &#x2192; Stream poller pulls &lt;b&gt;&#x2264;1000ms&lt;/b&gt; (batch) &#x2192; publish_records + queue.put &lt;b&gt;~1ms&lt;/b&gt; &#x2192; ALB &#x2192; URLSession.bytes flush &lt;b&gt;~50ms&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;align=left;verticalAlign=middle;fontSize=11;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="1560" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ssee-1" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="sse-step1" target="sse-step2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ssee-2" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=2;dashed=1;" edge="1" parent="1" source="sse-step2" target="sse-step3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ssee-3" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="sse-step3" target="sse-step4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ssee-4" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="sse-step4" target="sse-step5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ssee-5" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="sse-step5" target="sse-step6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ssee-6" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="sse-step6" target="sse-step7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ssee-7" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="sse-step7" target="sse-step8"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="iam" name="5. IAM / Security Boundaries">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-iam" value="IAM Roles &amp; Security Boundaries" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-iam" value="Who can call what. Trust relationships and resource grants from cawnex-stack.ts." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="iam-cog" value="&lt;b&gt;Cognito User Pool&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;issues JWTs for iOS + Web clients.&lt;br&gt;Trust: Cognito validates user credentials, signs token.&lt;br&gt;Audience claim = client_id (iOS or Web).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="iam-jwks" value="&lt;b&gt;Cognito JWKS&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;https://cognito-idp.us-east-1.amazonaws.com/&lt;br&gt;{pool}/.well-known/jwks.json&lt;br&gt;Public &#x2014; no auth required&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="iam-api" value="&lt;b&gt;API Lambda role&lt;/b&gt;&lt;br&gt;cawnex-api-${stage}&#x2014;Role&lt;br&gt;&lt;font color=#666&gt;Trust: lambda.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; RW main table + GSI Query&lt;br&gt;&#x2022; RW events table&lt;br&gt;&#x2022; RW artifacts S3, R assets S3&lt;br&gt;&#x2022; KMS encrypt: vault key&lt;br&gt;&#x2022; SQS Send: tasks queue&lt;br&gt;&#x2022; ECS UpdateService/DescribeServices on worker&lt;br&gt;&#x2022; SecretsManager Read: 3 secrets&lt;br&gt;&#x2022; &lt;b&gt;GITHUB_TOKEN injected as plain env via unsafeUnwrap() &#x26a0;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="380" height="240" as="geometry" />
        </mxCell>

        <mxCell id="iam-murder" value="&lt;b&gt;Murder Lambda role&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Trust: lambda.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; RW main + events&lt;br&gt;&#x2022; DDB Stream read: main&lt;br&gt;&#x2022; (no ECS &#x2014; only scaler/api scale Workers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="380" height="160" as="geometry" />
        </mxCell>

        <mxCell id="iam-monarch" value="&lt;b&gt;Monarch Lambda role&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Trust: lambda.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; RW main + events&lt;br&gt;&#x2022; DDB Stream read: main&lt;br&gt;&#x2022; ECS UpdateService/DescribeServices on worker&lt;br&gt;&#x2022; SecretsManager Read: anthropic-auth-token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="380" height="180" as="geometry" />
        </mxCell>

        <mxCell id="iam-council" value="&lt;b&gt;Council Lambda role&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Trust: lambda.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; RW main + events&lt;br&gt;&#x2022; DDB Stream read: main (SK begins COUNCIL#)&lt;br&gt;&#x2022; SecretsManager Read: anthropic-auth-token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="480" width="380" height="160" as="geometry" />
        </mxCell>

        <mxCell id="iam-scaler" value="&lt;b&gt;Worker-scaler Lambda role&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Trust: lambda.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; R main table&lt;br&gt;&#x2022; ECS UpdateService/DescribeServices on worker&lt;br&gt;&lt;font color=#666&gt;Idles worker desiredCount to 0 when no claimed work for &gt;15min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="660" width="380" height="170" as="geometry" />
        </mxCell>

        <mxCell id="iam-checker" value="&lt;b&gt;Checker Lambda role&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Trust: lambda.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; RW main table&lt;br&gt;&#x2022; SQS Send: tasks queue&lt;br&gt;&lt;font color=#666&gt;Hourly cron &#x2014; releases abandoned claims&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="850" width="380" height="160" as="geometry" />
        </mxCell>

        <mxCell id="iam-worker" value="&lt;b&gt;Worker task role&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Trust: ecs-tasks.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; RW main table + dynamodb:Query on index/*&lt;br&gt;&#x2022; RW events table (writes events for SSE)&lt;br&gt;&#x2022; RW artifacts S3, R assets S3&lt;br&gt;&#x2022; KMS decrypt: vault key&lt;br&gt;&#x2022; SQS Consume+Send: tasks queue&lt;br&gt;&#x2022; EFS Client RW (via mount IAM)&lt;br&gt;&#x2022; SecretsManager via container ecs.Secret:&lt;br&gt;&#x2002;&#x2002;&#x2014; GITHUB_TOKEN&lt;br&gt;&#x2002;&#x2002;&#x2014; ANTHROPIC_AUTH_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="420" height="260" as="geometry" />
        </mxCell>

        <mxCell id="iam-stream" value="&lt;b&gt;Stream task role&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Trust: ecs-tasks.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; R main table (project &#x2192; tenant lookup)&lt;br&gt;&#x2022; R events table&lt;br&gt;&#x2022; SQS Consume: stream-events queue&lt;br&gt;&#x2022; SecretsManager via ecs.Secret: PIPE_SECRET&lt;br&gt;&lt;font color=#666&gt;Fetches Cognito JWKS over public internet for JWT validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="380" width="420" height="200" as="geometry" />
        </mxCell>

        <mxCell id="iam-pipe" value="&lt;b&gt;StreamPipeRole&lt;/b&gt;&lt;br&gt;cawnex-stream-pipe-${stage}&lt;br&gt;&lt;font color=#666&gt;Trust: pipes.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; DDB Stream read on events-table (GetRecords, GetShardIterator, &lt;b&gt;ListShards&lt;/b&gt;, DescribeStream)&lt;br&gt;&#x2022; SQS Send: stream-events queue&lt;br&gt;&#x2022; CloudWatch Logs write to /aws/vendedlogs/pipes/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="600" width="420" height="200" as="geometry" />
        </mxCell>

        <mxCell id="iam-pc" value="&lt;b&gt;Post-confirmation Lambda role&lt;/b&gt;&lt;br&gt;&lt;font color=#666&gt;Trust: lambda.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;br&gt;Permissions:&lt;br&gt;&#x2022; RW main table&lt;br&gt;&lt;font color=#666&gt;Runs in AuthStack &#x2014; creates tenant + seed project on signup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="820" width="420" height="160" as="geometry" />
        </mxCell>

        <mxCell id="iam-warn" value="&lt;b&gt;&#x26a0; Security observations from audit&lt;/b&gt;&#10;&#10;1. API Lambda receives GITHUB_TOKEN as a &lt;b&gt;plain env var&lt;/b&gt; via secretValue.unsafeUnwrap() &#x2014; the token literal appears in CloudFormation template + Lambda console. Worker correctly uses ecs.Secret (resolved at task start, not stored in task def). Move API to a runtime SecretsManager fetch.&#10;&#10;2. ALB listener is &lt;b&gt;HTTP/80 only&lt;/b&gt; &#x2014; SSE traffic crosses public internet unencrypted. Add ACM cert + :443 listener before prod traffic.&#10;&#10;3. Cognito Web client has no supportedIdentityProviders filter &#x2014; defaults open to any future IdP added at pool level.&#10;&#10;4. Dev/staging Fargate tasks run in &lt;b&gt;public subnets with public IPs&lt;/b&gt; (no NAT) &#x2014; SG ingress is the only network boundary. Acceptable for dev, would need re-evaluation for staging if exposed externally." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f2;strokeColor=#b85450;fontSize=11;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="100" width="420" height="600" as="geometry" />
        </mxCell>

        <mxCell id="iam-flow-note" value="&lt;b&gt;Request flow under IAM&lt;/b&gt;&#10;&#10;iOS &#x2192; Cognito (SRP login) &#x2192; receives JWT (aud=iOS clientId)&#10;iOS &#x2192; CloudFront &#x2192; HTTP API GW &#x2192; (JWT authorizer validates against Cognito) &#x2192; API Lambda role assumed&#10;API Lambda &#x2192; DDB / SQS / Secrets / ECS via its role&#10;DDB Streams &#x2192; Lambda event source (no role assumed by Lambda &#x2014; Lambda&#x27;s execution role has dynamodb:GetRecords from stream config)&#10;DDB Streams (events) &#x2192; EventBridge Pipe assumes StreamPipeRole &#x2192; reads stream &#x2192; writes to SQS&#10;Stream Fargate task &#x2192; assumes Stream task role &#x2192; polls SQS, reads main+events DDB, fetches JWKS&#10;Stream Fargate &#x2192; iOS responses encoded as SSE through ALB (no IAM on response path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#dddddd;align=left;verticalAlign=top;fontSize=11;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="720" width="420" height="320" as="geometry" />
        </mxCell>

        <mxCell id="iame-1" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="iam-cog" target="iam-api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="320" /></Array></mxGeometry></mxCell>
        <mxCell id="iame-1-lbl" value="JWT validate" style="edgeLabel;html=1;fontSize=10;fontColor=#d79b00;fontStyle=2;" vertex="1" connectable="0" parent="iame-1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="iame-2" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="iam-jwks" target="iam-stream"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="260" /><mxPoint x="880" y="480" /></Array></mxGeometry></mxCell>
        <mxCell id="iame-2-lbl" value="JWKS fetch" style="edgeLabel;html=1;fontSize=10;fontColor=#d79b00;fontStyle=2;" vertex="1" connectable="0" parent="iame-2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="data" name="6. Data / Storage Map">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-data" value="Data &amp; Storage Map &#x2014; what lives where, who reads/writes it" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-data" value="DynamoDB SK patterns &#x2022; EFS per-tenant layout &#x2022; S3 buckets &#x2022; Secrets Manager &#x2022; ECR &#x2022; CloudWatch Logs." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="data-ddb-main-title" value="&lt;b&gt;DynamoDB&lt;/b&gt; cawnex-${stage} &#183; main table &#183; single-table design" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;fontColor=#0a4d2b;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="900" height="32" as="geometry" />
        </mxCell>

        <mxCell id="data-ddb-h-pk" value="PK" style="text;html=1;strokeColor=none;fillColor=#82b366;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="data-ddb-h-sk" value="SK pattern" style="text;html=1;strokeColor=none;fillColor=#82b366;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="140" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="data-ddb-h-purpose" value="Purpose" style="text;html=1;strokeColor=none;fillColor=#82b366;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
