  <diagram id="data" name="5. Data Model">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-d" value="Data Model — Single-Table DynamoDB" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-d" value="cawnex-{stage} and cawnex-events-{stage}. PK groups tenant+project; SK prefix identifies entity." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="pk-spec" value="&lt;b&gt;Partition Key (PK) shape&lt;/b&gt;&#10;&#10;&lt;b style=&quot;color:#5e26b3&quot;&gt;T#{tenant_id}#P#{project_id}&lt;/b&gt;&#10;&#10;Tenant isolation lives in the PK. Cross-tenant queries are&#10;impossible without forging a JWT &amp; bypassing TenantDB +&#10;four-layer IAM defense." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sk-rule" value="&lt;b&gt;Sort Key (SK) rules&lt;/b&gt;&#10;&#10;SK prefix tells you the entity type. Ordering inside a&#10;partition is alphabetical on SK.&#10;&#10;Wave items use &lt;b&gt;S#{wave}#m{mvi}#cr_{id}&lt;/b&gt; so a single Query&#10;hydrates a whole wave hierarchy.&#10;&#10;GSI1 indexes by GSI1PK / GSI1SK for cross-project queries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="500" height="220" as="geometry" />
        </mxCell>

        <mxCell id="sec-main" value="cawnex-{stage} — primary table" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#5e26b3;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="600" height="40" as="geometry" />
        </mxCell>

