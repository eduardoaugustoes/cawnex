        <mxCell id="lc-r-impllbl" value="parallel implementers, isolated worktrees, cost-routed by task complexity" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
