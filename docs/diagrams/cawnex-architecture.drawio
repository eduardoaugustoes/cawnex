        </mxCell>
        <mxCell id="L-loop" value="5. Tool-use loop with Claude&#10;&#10;count_tokens precheck &#x2192; messages.stream()&#10;tools: read_file, grep, glob, list_dir&#10;terminator: submit_result&#10;dynamic max_tokens, streaming &#x2265; 16k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#5e26b3;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="140" width="320" height="100" as="geometry" />
