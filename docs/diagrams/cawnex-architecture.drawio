        <mxCell id="lc-r-hsum" value="&lt;b&gt;Human summarizer&lt;/b&gt; (Haiku)&lt;br&gt;takes structured outcome &#x2192; 1-line headline + 3 bullets + concerns&lt;br&gt;&lt;font color=#ddd&gt;Lawrence Jones&#x27;s separate-layer-for-humans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#5e26b3;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
