        <mxCell id="lc-r-rev" value="&lt;b&gt;Reviewer crow&lt;/b&gt; (Haiku, adversarial)&lt;br&gt;cites cawnex.md / codex.md rules&lt;br&gt;structured findings + cited_rules[]&lt;br&gt;&lt;font color=#888&gt;Cloudflare codecs pattern&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
