        <mxCell id="lc-r-deter" value="&lt;b&gt;Deterministic verification gate&lt;/b&gt; (in Worker, before reviewer)&lt;br&gt;black --check &#183; flake8 &#183; mypy &#183; pytest &#183; project-specific checks&lt;br&gt;&lt;font color=#ddd&gt;failures become Reviewer&#x27;s blocking_issues with structured output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#5e26b3;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
