            "CONFIG_SET_NAME": "cawnex-dev",
            "DOMAIN_NAME": "cawnex.ai",
            "STAGE": "dev",
          },
        },
        "FunctionName": "cawnex-custom-email-sender-dev",
        "Handler": "handler.handler",
        "MemorySize": 256,
        "Role": {
          "Fn::GetAtt": [
            "CustomEmailSenderFnServiceRole38AB7F79",
            "Arn",
          ],
        },
        "Runtime": "python3.12",
        "Timeout": 30,
      },
      "Type": "AWS::Lambda::Function",
    },
    "CustomEmailSenderFnLogRetentionD79CF12E": {
      "Properties": {
        "LogGroupName": {
          "Fn::Join": [
            "",
            [
              "/aws/lambda/",
              {
                "Ref": "CustomEmailSenderFnD84756D8",
