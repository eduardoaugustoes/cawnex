        "Name": "CawnexAuthStack-dev-TableStreamArn",
      },
      "Value": {
        "Fn::GetAtt": [
          "MainTable74195DAB",
          "StreamArn",
        ],
      },
    },
    "UserPoolArn": {
      "Description": "Cognito User Pool ARN",
      "Export": {
        "Name": "CawnexAuthStack-dev-UserPoolArn",
      },
      "Value": {
        "Fn::GetAtt": [
          "UserPool6BA7E5F2",
          "Arn",
        ],
      },
    },
    "UserPoolId": {
      "Description": "Cognito User Pool ID",
      "Export": {
        "Name": "CawnexAuthStack-dev-UserPoolId",
      },
      "Value": {
        "Ref": "UserPool6BA7E5F2",
