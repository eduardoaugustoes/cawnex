exports[`CDK template snapshots matches the CawnexAuthStack (dev) snapshot 1`] = `
{
  "Description": "Cawnex Authentication Stack (dev)",
  "Outputs": {
    "CognitoDomain": {
      "Description": "Cognito hosted UI domain",
      "Export": {
        "Name": "CawnexAuthStack-dev-CognitoDomain",
      },
      "Value": {
        "Ref": "UserPoolDomainD0EA232A",
      },
    },
    "CustomEmailSenderArn": {
      "Description": "Custom Email Sender Lambda ARN",
      "Export": {
        "Name": "CawnexAuthStack-dev-CustomEmailSenderArn",
      },
      "Value": {
        "Fn::GetAtt": [
          "CustomEmailSenderFnD84756D8",
          "Arn",
        ],
      },
    },
    "Region": {
      "Description": "AWS region for SDK configuration",
      "Export": {
        "Name": "CawnexAuthStack-dev-Region",
      },
      "Value": "us-east-1",
    },
    "TableArn": {
      "Description": "DynamoDB table ARN",
      "Export": {
        "Name": "CawnexAuthStack-dev-TableArn",
      },
      "Value": {
        "Fn::GetAtt": [
          "MainTable74195DAB",
          "Arn",
        ],
      },
    },
    "TableName": {
      "Description": "DynamoDB table name",
